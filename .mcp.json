{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn-vue": {
            "command": "npx",
            "args": [
                "-y",
                "shadcn-vue@latest",
                "mcp"
            ]
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp"
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "motionsites": {
            "type": "http",
            "url": "https://xgdzyqfalbibzelpdpvr.supabase.co/functions/v1/mcp"
        }
    }
}

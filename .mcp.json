{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn-vue": {
            "command": "npx",
            "args": [
                "-y",
                "shadcn-vue@latest",
                "mcp"
            ]
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp"
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "magic-21st": {
            "command": "npx",
            "args": [
                "-y",
                "@21st-dev/magic@latest"
            ],
            "env": {
                "API_KEY": "${TWENTY_FIRST_API_KEY:-}"
            }
        },
        "motionsites": {
            "type": "http",
            "url": "https://xgdzyqfalbibzelpdpvr.supabase.co/functions/v1/mcp"
        }
    }
}

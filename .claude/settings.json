{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(php artisan:*)",
            "Bash(composer ci:check)",
            "Bash(composer test)",
            "Bash(composer lint)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(npm run:*)",
            "Bash(npx vp:*)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(python .claude/skills/ui-ux-pro-max/scripts/search.py:*)",
            "Bash(python .claude/skills/ui-ux-pro-max/scripts/design_system.py:*)",
            "WebFetch(domain:raw.githubusercontent.com)",
            "mcp__laravel-boost",
            "mcp__shadcn-vue",
            "mcp__context7",
            "mcp__playwright",
            "mcp__motionsites"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.production)",
            "Read(./.env.backup)",
            "Bash(php artisan migrate:fresh:*)",
            "Bash(php artisan db:wipe:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    },
    "enableAllProjectMcpServers": false,
    "enabledMcpjsonServers": [
        "laravel-boost",
        "shadcn-vue",
        "context7",
        "playwright",
        "motionsites"
    ]
}
